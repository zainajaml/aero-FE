# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (0 when exposed directly).
TRUST_PROXY=0

# --- Database ---
DATABASE_URL=postgres://azf:azf_dev_password@127.0.0.1:5434/aero_zenith_flow
DATABASE_POOL_MAX=10

# --- URLs ---
# Browser origin of the frontend (used for CORS, CSRF origin checks and email links).
APP_URL=http://localhost:5173
# Public origin of this API (used for auth callbacks and email verification links).
API_URL=http://localhost:4000
# Extra allowed browser origins, comma separated.
CORS_ORIGINS=

# --- Auth ---
# At least 32 random characters; generate with: openssl rand -base64 48
AUTH_SECRET=
# Optional Google sign-in (set both or neither).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only addresses in this domain may hold the super_admin role.
SUPER_ADMIN_EMAIL_DOMAIN=spacemanconsulting.com

# --- Email ---
# SMTP connection URL (Mailpit locally: smtp://127.0.0.1:1026). "memory://" captures mail in tests.
SMTP_URL=smtp://127.0.0.1:1026
EMAIL_FROM=Space Scope <noreply@spacescope.ai>

# --- Object storage (S3-compatible; RustFS locally) ---
# Leave S3_ENDPOINT empty for AWS S3; set it for R2, RustFS or another S3-compatible service.
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=aero-zenith-flow
S3_ACCESS_KEY_ID=azf_storage
S3_SECRET_ACCESS_KEY=azf_storage_secret
# true for RustFS/MinIO-style path addressing.
S3_FORCE_PATH_STYLE=true
# Lifetime of signed download URLs.
FILE_URL_TTL_SECONDS=3600

# --- GCP billing report (optional; the Billing page is disabled when unset) ---
BILLING_API_URL=
BILLING_API_KEY=
BILLING_TENANT_ID=

# --- Jira import (optional; set all four or none) ---
# Atlassian OAuth 2.0 (3LO) app; register JIRA_REDIRECT_URI (…/api/v1/jira/oauth/callback) in the developer console.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=
# At least 32 random characters; encrypts stored Jira tokens (AES-256-GCM).
JIRA_TOKEN_ENCRYPTION_KEY=
