{
  "name": "aero-zenith-flow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/database/migrations dist/database/",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx --env-file=.env src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && drizzle-kit generate --name=drift-check | grep -q \"No schema changes\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "deps:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "deps:unused": "knip",
    "bootstrap:super-admin": "tsx --env-file=.env scripts/bootstrap-super-admin.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.87",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@better-auth/drizzle-adapter": "1.7",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "ai": "^7.0.126",
    "better-auth": "1.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "p-retry": "^8.0.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "madge": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
